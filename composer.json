{
    "name": "fojlerabbirabib/laravel-spa-analytics",
    "description": "Self-hosted, first-party analytics for Laravel — traffic, real-time visitors, funnels, goals and campaign tracking, with data that never leaves your own infrastructure.",
    "keywords": [
        "laravel",
        "analytics",
        "self-hosted",
        "spa",
        "tracking"
    ],
    "homepage": "https://github.com/FojleRabbiRabib/laravel-spa-analytics",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Fojle Rabbi",
            "email": "fojlyrabbi.bd@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FojleRabbiRabib\\LaravelSpaAnalytics\\": "src/",
            "FojleRabbiRabib\\LaravelSpaAnalytics\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FojleRabbiRabib\\LaravelSpaAnalytics\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FojleRabbiRabib\\LaravelSpaAnalytics\\LaravelSpaAnalyticsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
